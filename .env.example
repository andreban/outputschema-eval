# Gemini API Key (any of these three variable names is accepted, matching webmcp-evals)
GOOGLE_AI=your_gemini_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# Optional custom base URL for corporate gateways or proxies
# GOOGLE_GENERATIVE_AI_BASE_URL=https://your-proxy.example.com/google
