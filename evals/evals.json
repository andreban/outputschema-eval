  {
    "name": "Chain: Add Official Replacement Power Adapter to Cart (get_product_specs -> update_cart_items)",
    "category": "multi_step_chaining",
    "description": "update_cart_items requires sku_code. outputSchema shows that get_product_specs returns replacement_adapter_sku for product_id PROD-10 (whereas without outputSchema the agent searches the catalog).",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Add 1 unit of the official replacement power adapter for product PROD-10 to my cart."
      }
    ],
    "expectedCall": [
      {
        "functionName": "get_product_specs",
        "arguments": {
          "product_id": "PROD-10"
        },
        "mockOutput": {
          "product_id": "PROD-10",
          "model_number": "UW-3400-PRO",
          "warranty_months": 24,
          "power_watts": 65,
          "dimensions_cm": "81x36x12",
          "replacement_adapter_sku": "SKU-PWR-65W",
          "variants": [
            {
              "sku_code": "SKU-MON-34B",
              "color": "Matte Black",
              "capacity": "34-inch",
              "unit_price_usd": 450
            }
          ]
        }
      },
      {
        "functionName": "update_cart_items",
        "arguments": {
          "items": [
            {
              "sku_code": "SKU-PWR-65W",
              "quantity": 1
            }
          ]
        },
        "mockOutput": {
          "cart_id": "CART-1",
          "line_items": [
            {
              "sku_code": "SKU-PWR-65W",
              "quantity": 1,
              "subtotal_usd": 49
            }
          ],
          "cart_total_usd": 49
        }
      }
    ]
  },
  {
    "name": "Multi-Turn: Catalog Search Followed by Replacement Adapter Stock Check (get_product_specs -> check_warehouse_stock)",
    "category": "multi_turn_conversation",
    "description": "Turn 1 ran search_catalog and returned product_id PROD-10. Turn 2 asks to check warehouse stock in postal code 94105 for the official replacement power adapter for that monitor; outputSchema shows get_product_specs returns replacement_adapter_sku.",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Search the electronics catalog for 34-inch ultrawide monitors."
      },
      {
        "role": "model",
        "type": "functioncall",
        "name": "search_catalog",
        "arguments": {
          "query": "34-inch ultrawide monitor",
          "category": "electronics"
        }
      },
      {
        "role": "user",
        "type": "functionresponse",
        "name": "search_catalog",
        "response": {
          "result": {
            "items": [
              {
                "product_id": "PROD-10",
                "name": "ProView 34 Ultrawide",
                "brand": "ProView",
                "base_price_usd": 450,
                "rating_avg": 4.6
              }
            ],
            "page_size": 12,
            "total_count": 1,
            "total_pages": 1
          }
        }
      },
      {
        "role": "model",
        "type": "message",
        "content": "I found the ProView 34 Ultrawide monitor (PROD-10) for $450."
      },
      {
        "role": "user",
        "type": "message",
        "content": "Check if the official replacement power adapter for that monitor is in stock near postal code 94105."
      }
    ],
    "expectedCall": [
      {
        "functionName": "get_product_specs",
        "arguments": {
          "product_id": "PROD-10"
        },
        "mockOutput": {
          "product_id": "PROD-10",
          "model_number": "UW-3400-PRO",
          "warranty_months": 24,
          "power_watts": 65,
          "dimensions_cm": "81x36x12",
          "replacement_adapter_sku": "SKU-PWR-65W",
          "variants": [
            {
              "sku_code": "SKU-MON-34B",
              "color": "Matte Black",
              "capacity": "34-inch",
              "unit_price_usd": 450
            }
          ]
        }
      },
      {
        "functionName": "check_warehouse_stock",
        "arguments": {
          "sku_code": "SKU-PWR-65W",
          "postal_code": "94105"
        },
        "mockOutput": {
          "sku_code": "SKU-PWR-65W",
          "in_stock": true,
          "available_units": 12,
          "warehouse_bin_id": "BIN-SFO-P04",
          "earliest_pickup_window": "Today 14:00-18:00"
        }
      }
    ]
  }
]
