  {
    "name": "Chain: Search Flights to NYC from Usual Location (get_loyalty_benefits -> search_flights)",
    "category": "multi_step_chaining",
    "description": "User asks to travel to NYC (JFK) from their usual location. outputSchema reveals that home_airport_iata is returned by get_loyalty_benefits (not get_user_preferences).",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "I want to travel to NYC (JFK) on 2026-11-20 from my usual location. What flights are available?"
      }
    ],
    "expectedCall": [
      {
        "functionName": "get_loyalty_benefits",
        "arguments": {},
        "mockOutput": {
          "membership_tier": "Titanium",
          "points_balance": 84500,
          "home_airport_iata": "SFO",
          "preferred_seat_type": "aisle",
          "companion_voucher_code": "COMP-2026-99A",
          "lounge_pass_code": "LNG-TITAN-77",
          "free_checked_bags": 2,
          "priority_boarding_group": "Group 1",
          "annual_travel_credit_usd": 300,
          "free_return_shipping": true,
          "extended_warranty_months": 12,
          "concierge_phone_ext": "8800",
          "tier_expiration_date": "2027-03-31"
        }
      },
      {
        "functionName": "search_flights",
        "arguments": {
          "origin_iata": "SFO",
          "destination_iata": "JFK",
          "departure_date": "2026-11-20"
        },
        "mockOutput": {
          "flights": [
            {
